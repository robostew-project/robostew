FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

WORKDIR /app

# RoboStew uses only Node.js built-ins at runtime. Remove unused package-manager
# trees so their tooling-only dependencies are not shipped in the final image.
RUN rm -rf \
    /opt/yarn* \
    /usr/local/bin/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/yarn \
    /usr/local/bin/yarnpkg \
    /usr/local/lib/node_modules/corepack \
    /usr/local/lib/node_modules/npm

COPY local/ /app/local/

USER node

EXPOSE 8080

CMD ["node", "local/server.mjs"]
