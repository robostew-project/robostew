FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

WORKDIR /app

# RoboStew uses only Node.js built-ins at runtime. Remove unused package-manager
# trees so their tooling-only dependencies are not shipped in the final image.
RUN rm -rf \
    /opt/yarn* \
    /usr/local/bin/corepack \
    /usr/local/bin/npm \
    /usr/local/bin/npx \
    /usr/local/bin/yarn \
    /usr/local/bin/yarnpkg \
    /usr/local/lib/node_modules/corepack \
    /usr/local/lib/node_modules/npm

COPY local/ /app/local/

USER node

EXPOSE 8080

CMD ["node", "local/server.mjs"]
